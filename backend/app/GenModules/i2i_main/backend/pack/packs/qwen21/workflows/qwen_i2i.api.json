{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Qwen Image 2.1 Turbo diffusion model" },
    "inputs": {
      "unet_name": "qwen_image_2.1_turbo_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL 8B text encoder" },
    "inputs": {
      "clip_name": "qwen3vl_8b_bf16.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Qwen Image 2.1 VAE" },
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "4": {
    "class_type": "QwenImage21Cache",
    "_meta": { "title": "Qwen Image 2.1 cache" },
    "inputs": {
      "model": ["1", 0],
      "device": "auto",
      "dtype": "default"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": { "title": "Reference image 1" },
    "inputs": {
      "image": "genai_i2i_reference_1.png"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": { "title": "Reference image 2" },
    "inputs": {
      "image": "genai_i2i_reference_2.png"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "Reference image 3" },
    "inputs": {
      "image": "genai_i2i_reference_3.png"
    }
  },
  "8": {
    "class_type": "TextEncodeQwenImage21",
    "_meta": { "title": "Qwen Image 2.1 prompt and references" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "",
      "negative_prompt": "",
      "resolution": 1024,
      "images.image_1": ["5", 0]
    }
  },
  "9": {
    "class_type": "SamplerCustom",
    "_meta": { "title": "Qwen Image 2.1 Turbo sampler (shipped 8-step sigmas)" },
    "inputs": {
      "model": ["4", 0],
      "add_noise": true,
      "noise_seed": 0,
      "cfg": 1.0,
      "positive": ["8", 0],
      "negative": ["8", 1],
      "sampler": ["16", 0],
      "sigmas": ["15", 0],
      "latent_image": ["12", 0]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode the edited image" },
    "inputs": {
      "samples": ["9", 0],
      "vae": ["3", 0]
    }
  },
  "11": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save the edited image" },
    "inputs": {
      "images": ["10", 0],
      "filename_prefix": "genai_i2i/preview"
    }
  },
  "12": {
    "class_type": "RepeatLatentBatch",
    "_meta": { "title": "Batch the edit" },
    "inputs": {
      "samples": ["8", 2],
      "amount": 1
    }
  },
  "13": {
    "class_type": "ImageScale",
    "_meta": { "title": "Scale the first reference for the img2img path" },
    "inputs": {
      "image": ["5", 0],
      "upscale_method": "lanczos",
      "width": 1024,
      "height": 1024,
      "crop": "disabled"
    }
  },
  "14": {
    "class_type": "VAEEncode",
    "_meta": { "title": "Encode the first reference for the img2img path" },
    "inputs": {
      "pixels": ["13", 0],
      "vae": ["3", 0]
    }
  },
  "15": {
    "class_type": "ManualSigmas",
    "_meta": { "title": "Qwen Image 2.1 Turbo 8-step sigmas" },
    "inputs": {
      "sigmas": "1.0, 0.978453, 0.95418, 0.926626, 0.89508, 0.845148, 0.704534, 0.414568, 0.0"
    }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "_meta": { "title": "Qwen Image 2.1 sampler" },
    "inputs": {
      "sampler_name": "euler"
    }
  }
}
