      "loader": "UNETLoader",
      "file": "qwen_image_2.1_turbo_bf16.safetensors",
      "target": "unet",
      "aliases": [
        "qwen_image_2.1_turbo",
        "qwenimage21turbo",
        "qwen_image_2_1_turbo"
      ],
      "fallbackAliases": ["qwen_image_2.1", "qwenimage21"],
      "excludeAliases": [
        "text_encoder",
        "textencoder",
        "qwen3vl",
        "vae",
        "pe_i2i"
      ],
      "baseGroup": "qwen21-diffusion",
      "baseGroupLabel": "Qwen Image 2.1 Turbo diffusion model",
      "required": true,
      "tested": true,
      "verified": true,
      "nsfw": false,
      "pageUrl": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1",
      "textEncoder": "qwen3vl_8b_bf16.safetensors",
      "textEncoderAliases": [
        "qwen3vl_8b",
        "qwen3vl8b",
        "qwen3vl_8b_bf16",
        "qwen3vl_8b_int8",
        "qwen3vl_8b_int8_convrot",
        "qwen_image_2.1_vl_turbo",
        "qwenimage21vl"
      ],
      "textEncoderExcludeAliases": ["vae"],
      "textEncoderTarget": "text_encoders",
      "clipType": "qwen_image",
