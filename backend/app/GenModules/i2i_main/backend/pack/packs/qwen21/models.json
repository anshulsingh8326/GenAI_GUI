          "default": 1.0,
          "step": 0.05,
          "recommendedMin": 1.0,
          "recommendedMax": 2.0,
          "hardMin": 1.0,
          "hardMax": 8.0,
          "description": "Keep 1.0 for the official turbo schedule; higher values only help unusual edits."
        },
        "denoise": {
          "label": "Denoise",
          "min": 0.05,
          "max": 1.0,
          "default": 1.0,
          "step": 0.01,
          "recommendedMin": 0.35,
          "recommendedMax": 1.0,
          "hardMin": 0.05,
          "hardMax": 1.0,
          "description": "1.0 follows the official edit path; below 1.0 starts from the VAE-encoded source and keeps more of it."
        },
        "batch": {
          "label": "Batch",
          "min": 1,
          "max": 4,
          "default": 1,
          "step": 1,
          "recommendedMin": 1,
          "recommendedMax": 2,
          "hardMin": 1,
          "hardMax": 4,
          "description": "Independent variations of the same source and prompt."
        },
        "seed": {
          "label": "Seed",
          "min": 0,
          "max": 4294967295,
          "default": 0,
          "step": 1,
          "recommendedMin": 0,
          "recommendedMax": 4294967295,
          "hardMin": 0,
          "hardMax": 4294967295
        }
      },
      "vram": "bf16 ~20 GB / int8 ~10 GB estimate",
      "capabilities": ["image-to-image", "image-edit", "reference-image", "multi-reference"],
      "notes": "Uses the official Qwen Image 2.1 core nodes (TextEncodeQwenImage21, QwenImage21Cache) plus SamplerCustom + ManualSigmas so the checkpoint's own 8-step turbo sigmas drive sampling; KSampler's `simple` scheduler does not match that curve. Accepts up to three reference images, addressed as <image1>..<image3> in the prompt. Requires ComfyUI 0.37.0 or newer."
