      "vaeAliases": [
        "qwen_image_2.1_vae",
        "qwenimage21vae",
        "qwen_image_2_1_vae",
        "qwen_image_21_vae"
      ],
      "vaeExcludeAliases": ["qwen_image_vae"],
      "vaeTarget": "vae",
      "workflow": "workflows/qwen_i2i.api.json",
      "composer": "qwen21_i2i",
      "ranges": {
        "steps": {
          "label": "Steps",
          "min": 4,
          "max": 20,
