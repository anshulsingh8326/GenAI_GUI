{
  "version": 1,
  "description": "T2I_main model bindings and per-model ranges. This file is authoritative for the Text -> Image module; edit it (within the hard limits) to widen ranges for pro use.",
  "models": [
    {
      "id": "krea2-turbo-int8",
      "catalogId": "model-snofssexnudesandother-krea2turbov14-int8",
      "label": "SNOFS-Krea2_Q8",
      "shortLabel": "SNOFS-Krea2_Q8",
      "family": "Krea 2",
      "base": "krea2",
      "description": "SNOFS Krea 2 Turbo V14 int8 (8-bit) diffusion model. Fast, LoRA-friendly and the reference Freeze v8 path.",
      "loader": "UNETLoader",
      "file": "snofsSexNudesAndOther_krea2TurboV14_int8.safetensors",
      "target": "unet",
      "weightDtype": "default",
      "textEncoder": "qwen3vl_4b_fp8_scaled.safetensors",
      "textEncoderTarget": "text_encoders",
      "clipType": "krea2",
      "vae": "qwen_image_vae.safetensors",
      "vaeTarget": "vae",
      "vram": "~8-10 GB",
      "capabilities": ["t2i", "lora", "refine", "esrgan"],
      "verified": true,
      "tested": true,
      "notes": "Reference path from Krea2_SNOFS_Freeze_v8. Uses UNETLoader + qwen3vl_4b_fp8_scaled (clip type krea2) + qwen_image_vae.",
      "defaults": {
        "steps": 12,
        "cfg": 2.5,
        "sampler": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      },
      "ranges": {
        "steps": {
          "label": "Steps",
          "min": 9,
          "max": 16,
          "default": 12,
          "step": 1,
          "recommendedMin": 10,
          "recommendedMax": 14,
          "hardMin": 1,
          "hardMax": 100,
          "unit": "steps",
          "description": "Krea 2 Turbo is distilled; 10-14 steps covers the useful range. More steps add time without detail."
        },
        "cfg": {
          "label": "CFG",
          "min": 1.5,
          "max": 5.0,
          "default": 2.5,
          "step": 0.1,
          "recommendedMin": 2.0,
          "recommendedMax": 3.0,
          "hardMin": 0.0,
          "hardMax": 30.0,
          "unit": "",
          "description": "2.0-3.0 follows the prompt; higher values increase contrast and can burn highlights."
        },
        "denoise": {
          "label": "Denoise",
          "min": 0.6,
          "max": 1.0,
          "default": 1.0,
          "step": 0.01,
          "recommendedMin": 0.9,
          "recommendedMax": 1.0,
          "hardMin": 0.0,
          "hardMax": 1.0,
          "unit": "",
          "description": "Text-to-image from empty latent normally uses 1.0. Lower values only make sense for a partial re-render."
        },
        "width": {
          "label": "Width",
          "min": 512,
          "max": 1536,
          "default": 1024,
          "step": 64,
          "recommendedMin": 640,
          "recommendedMax": 1536,
          "hardMin": 256,
          "hardMax": 4096,
          "unit": "px",
          "description": "Krea 2 working width. Auto-fit keeps both sides in the 640-1536 px band when possible; values outside it are warning-only."
        },
        "height": {
          "label": "Height",
          "min": 512,
          "max": 1536,
          "default": 1024,
          "step": 64,
          "recommendedMin": 640,
          "recommendedMax": 1536,
          "hardMin": 256,
          "hardMax": 4096,
          "unit": "px",
          "description": "Krea 2 working height. Auto-fit keeps both sides in the 640-1536 px band when possible; values outside it are warning-only."
        },
        "batch": {
          "label": "Batch",
          "min": 1,
          "max": 4,
          "default": 1,
          "step": 1,
          "recommendedMin": 1,
          "recommendedMax": 2,
          "hardMin": 1,
          "hardMax": 8,
          "unit": "images",
          "description": "Each extra image is another full sampling pass. 1-2 is comfortable on 12 GB."
        },
        "seed": {
          "label": "Seed",
          "min": 0,
          "max": 4294967295,
          "default": 0,
          "step": 1,
          "recommendedMin": 0,
          "recommendedMax": 4294967295,
          "hardMin": 0,
          "hardMax": 4294967295,
          "unit": "",
          "description": "Unlocked runs randomize this. Lock the seed to reproduce a result."
        },
        "refine": {
          "steps": {
            "label": "Refine steps",
            "min": 4,
            "max": 10,
            "default": 6,
            "step": 1,
            "recommendedMin": 5,
            "recommendedMax": 8,
            "hardMin": 1,
            "hardMax": 100,
            "unit": "steps",
            "description": "Refine pass at reduced denoise. Freeze v8 uses 6."
          },
          "cfg": {
            "label": "Refine CFG",
            "min": 1.5,
            "max": 3.0,
            "default": 2.0,
            "step": 0.1,
            "recommendedMin": 1.8,
            "recommendedMax": 2.5,
            "hardMin": 0.0,
            "hardMax": 30.0,
            "unit": "",
            "description": "Refine CFG. Freeze v8 uses 2.0."
          },
          "denoise": {
            "label": "Refine denoise",
            "min": 0.3,
            "max": 0.6,
            "default": 0.45,
            "step": 0.01,
            "recommendedMin": 0.35,
            "recommendedMax": 0.55,
            "hardMin": 0.0,
            "hardMax": 1.0,
            "unit": "",
            "description": "Low denoise preserves the base composition while adding detail. Freeze v8 uses 0.45."
          },
          "scale": {
            "label": "Refine size",
            "min": 1024,
            "max": 2048,
            "default": 1536,
            "step": 64,
            "recommendedMin": 1280,
            "recommendedMax": 1792,
            "hardMin": 512,
            "hardMax": 4096,
            "unit": "px",
            "description": "Long side of the refined latent, preserving the base aspect ratio. Freeze v8 uses 1536."
          }
        }
      }
    },
